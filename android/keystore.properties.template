# NotaGuard Android Signing Configuration
# ==========================================
# 
# 1. Copy this file to: android/keystore.properties
# 2. Replace placeholder values with your actual keystore credentials
# 3. NEVER commit keystore.properties to version control!
#
# To generate a new upload keystore:
# keytool -genkey -v -keystore notaguard-upload-key.keystore -alias notaguard-upload -keyalg RSA -keysize 2048 -validity 10000

# Path to keystore file (relative to android/ folder or absolute path)
NOTAGUARD_UPLOAD_STORE_FILE=notaguard-upload-key.keystore

# Keystore password
NOTAGUARD_UPLOAD_STORE_PASSWORD=your_keystore_password_here

# Key alias (must match what you used when creating the keystore)
NOTAGUARD_UPLOAD_KEY_ALIAS=notaguard-upload

# Key password (often same as keystore password)
NOTAGUARD_UPLOAD_KEY_PASSWORD=your_key_password_here
